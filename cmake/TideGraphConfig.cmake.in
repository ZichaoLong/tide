@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Torch @Torch_VERSION@ EXACT CONFIG REQUIRED)
find_dependency(Threads REQUIRED)
if(NOT CMAKE_SYSTEM_PROCESSOR STREQUAL "@CMAKE_SYSTEM_PROCESSOR@")
  message(FATAL_ERROR "TideGraph was built for @CMAKE_SYSTEM_PROCESSOR@; rebuild on the target architecture")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/TideGraphTargets.cmake")
check_required_components(TideGraph)
